{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "npm run setup && npm start",
    "healthcheckPath": "/api/state?order=PH-2401",
    "restartPolicyType": "ON_FAILURE"
  }
}
